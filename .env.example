# Copy to .env for local development. Never commit .env.
ENVIRONMENT=local
# Runtime role: NOT a superuser, NOT the table owner, NO BYPASSRLS.
DATABASE_URL=postgresql+asyncpg://hotel_app:change-me@localhost:5432/hotel_erp
# Owner role: migrations and scripts only. The app never connects as this.
OWNER_DATABASE_URL=postgresql+asyncpg://hotel_owner:change-me@localhost:5432/hotel_erp
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
