# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgresql+asyncpg://hotel_app:hotel_app@localhost:5432/hotel_erp
PLATFORM_DATABASE_URL=postgresql+asyncpg://hotel_platform:hotel_platform@localhost:5432/hotel_erp
MIGRATION_DATABASE_URL=postgresql+asyncpg://hotel_owner:hotel_owner@localhost:5432/hotel_erp
JWT_SECRET=change-me-locally
PUBLIC_DINER_URL=   # empty in dev; set https://your-domain/#/t in production
WEB_DIR=          # optional: path to Hotel-ERP-Frontend/build/web to serve it from the API
CORS_ORIGINS=*
# Razorpay (leave empty to disable plan checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Push notifications (Firebase Cloud Messaging HTTP v1). Leave empty to disable.
# Secret: the service account JSON (a file path or the JSON itself). Never commit it.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Public app identifiers from Firebase console > Project settings > Your apps (served to the apps at runtime).
FIREBASE_API_KEY=
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.hotelerp.hotelErp
# Web push certificate key pair (Cloud Messaging > Web configuration)
FIREBASE_VAPID_KEY=
