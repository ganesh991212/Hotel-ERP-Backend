# PRODUCTION values for the Render service hotel-erp-api-production. Reference only: never put real values in this file.
# Enter real values in Render > hotel-erp-api-production > Environment. Secrets are marked [SECRET].
#
# <ref>    Supabase project ref (Project Settings > General > Project ID), e.g. abcdefghijklmnopqrst
# <pooler> Supabase pooler host: Connect > Session pooler, e.g. aws-0-ap-southeast-1.pooler.supabase.com
#          Use the SESSION pooler (port 5432). Not "Direct" (IPv6 only; Render cannot reach it) and not the
#          transaction pooler on 6543 (breaks asyncpg prepared statements).
# Passwords are the ones you put into scripts/supabase-roles.sql for THIS project.

APP_ENV=production                   # set by render.yaml
RUN_RELEASE_ON_START=false           # set by render.yaml (migrations run as the pre-deploy command)
JWT_SECRET=                          # [SECRET] generated by Render; different from staging

# Note the scheme (postgresql+asyncpg), the user (<role>.<ref>) and ?ssl=require.
DATABASE_URL=postgresql+asyncpg://hotel_app.<ref>:<APP_PASSWORD>@<pooler>:5432/postgres?ssl=require                 # [SECRET]
PLATFORM_DATABASE_URL=postgresql+asyncpg://hotel_platform.<ref>:<PLATFORM_PASSWORD>@<pooler>:5432/postgres?ssl=require  # [SECRET]
MIGRATION_DATABASE_URL=postgresql+asyncpg://hotel_owner.<ref>:<OWNER_PASSWORD>@<pooler>:5432/postgres?ssl=require   # [SECRET]
DB_POOL_SIZE=5                       # set by render.yaml
DB_MAX_OVERFLOW=5                    # set by render.yaml

# The web app's URL. Check the real URL on the static site's page in Render (a suffix is added if the name is taken).
PUBLIC_DINER_URL=https://<your-domain>/#/t   # printed inside every table QR. Use your OWN domain: changing it later
#                              invalidates every QR card already printed in every hotel
CORS_ORIGINS=https://<your-domain>           # comma-separated, no trailing slash, never *

# First super admin. Created once on boot if the email does not exist; the password is never logged.
# Use the new project mailbox; change the password after first login and then clear this variable.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=             # [SECRET]

POWERED_BY_NAME=Vethra               # footer on printed QR cards
POWERED_BY_CONTACT=                  # e.g. website or phone; public text

# Razorpay LIVE keys (rzp_live_); the API refuses to start with test keys. Empty = plan checkout disabled.
# Webhook URL to register in Razorpay: https://<api-host>/api/v1/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                 # [SECRET]
RAZORPAY_WEBHOOK_SECRET=             # [SECRET]

# Push (Firebase). Separate Firebase project from staging. All empty = push off; in-app alerts still work.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=            # [SECRET] paste the whole service-account JSON on one line
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.hotelerp.hotelErp
FIREBASE_VAPID_KEY=

# ---- Static site hotel-erp-web-production (Render > hotel-erp-web-production > Environment) ----
# API_BASE=https://hotel-erp-api-production.onrender.com     # no trailing slash
# FLUTTER_VERSION=3.50.0                                  # set by render.yaml
